      "title": "Ping Ingestion Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(ping_admitted_total[1m])", "legendFormat": "Admitted / sec" },
        { "expr": "rate(ping_duplicate_total[1m])", "legendFormat": "Duplicate / sec" },
        { "expr": "rate(ping_rejected_total[1m])", "legendFormat": "Rejected ({{reason}}) / sec" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
