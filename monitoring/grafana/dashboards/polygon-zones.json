      "title": "Pipeline Queue Depth",
      "type": "timeseries",
      "targets": [
        { "expr": "ping_queue_depth", "legendFormat": "Queue Depth" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
