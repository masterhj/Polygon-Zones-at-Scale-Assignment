      "title": "Failures & Retries",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(checkpoint_failures_total[1m])", "legendFormat": "Checkpoint Failures / sec" },
        { "expr": "rate(ping_worker_failure_total[1m])", "legendFormat": "Worker Failures / sec" },
        { "expr": "rate(ping_backpressure_total[1m])", "legendFormat": "Backpressure / sec" }
      ]
    },
    {
      "collapsed": false,
