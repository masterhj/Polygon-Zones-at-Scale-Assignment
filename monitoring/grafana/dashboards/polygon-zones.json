      "title": "HTTP Request Rate by Endpoint",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{uri}} ({{status}})" }
